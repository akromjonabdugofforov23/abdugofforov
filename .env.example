# ============================================================
# ABDUGOFFOROV PLATFORM — ENVIRONMENT VARIABLES
# Ushbu fayldan nusxa olib, '.env' nomli fayl yarating va o'z kalitlaringizni kiriting
# ============================================================

# 1. Telegram Bot & 2FA (Ikkinchi bosqichli xavfsizlik)
# @BotFather dan olingan bot tokeni:
TELEGRAM_BOT_TOKEN=

# Sizning Telegram shaxsiy Chat ID raqamingiz (@userinfobot orqali bilish mumkin):
TELEGRAM_CHAT_ID=

# Kanalga avtomatik post tarqatish uchun kanal ID (masalan: @abdugofforov_channel):
TELEGRAM_CHANNEL_ID=

# 2. Xavfsiz Admin PIN (Ixtiyoriy, agar yangilamoqchi bo'lsangiz)
# SHA-256 xesh shaklida (masalan: 0509 uchun quyidagi xesh):
# ADMIN_PIN_HASH=827d5449d1f191275051481e75c4ce10e930a64b5585a546363c340d63347089
# ADMIN_PIN=0509

# 3. Google Gemini AI (Ixtiyoriy)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# 4. Server sozlamalari
PORT=8000
NODE_ENV=development
